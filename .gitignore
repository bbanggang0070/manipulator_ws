# Python 가상환경 (uv.lock으로 재생성: cd envs/lerobot && uv sync)
envs/*/.venv/
__pycache__/
*.pyc

# 학습 산출물 — 체크포인트는 HF Hub(heongyu/act_so101_t1 등)에 보관
envs/*/outputs/

# 로그·일시 파일
logs/
nohup.out

# 카메라 점검 스냅샷
setup/hardware/snapshots/


# 추론 영상(대용량) — repo 제외
inf_video/

# 오케스트레이터 실행 로그(로컬 전용)
.orchestrate.log

# 발표 자료 중 대용량 — GitHub Release(capstone-final)에 첨부
docs/slides/capstone_animated.pptx
demo_video/

# 오피스 잠금 파일
.~lock.*#

# 계획서 제출본 — 추정 내용이 섞여 있어 배포본에서 제외(c262cd2). 이력: git show ca31bc6:PROPOSAL.md
