+def reset_block_near_box(
+        env,
+        env_ids: torch.Tensor,
+        block_name: str,
+        box_name: str,
+        base_xy: tuple[float, float],
+        # 박스: 기존 reset_basket_random과 동일 사양
+        box_min_dist: float,
+        box_max_dist: float,
+        box_angle_range: tuple[float, float],
+        box_yaw_range: tuple[float, float],
+        box_z: float,
+        # 블록: 박스로부터의 '거리'를 직접 지정 (핵심)
+        block_dist_range: tuple[float, float],
+        block_min_dist: float,
+        block_max_dist: float,
+        block_angle_range: tuple[float, float],
+        block_z: float,
+        neg_theta_frac: float = 0.5,
+        max_tries: int = 200,
+):
+    """박스를 먼저 놓고, **그 주변 지정 거리대**에 블록을 놓는다 (v4 타깃 수집용).
+
+    왜 필요한가(2026-08-06):
+      v3@40k의 실패가 '블록이 박스에 가까운 배치'에 몰려 있었다(근접 39% vs 원거리 83%).
+      그런데 수집 때 겹침 ep를 제외하면서 **유효 근접 구간까지 함께 걸러져**, 학습 데이터의
+      근접 비율이 자연 분포의 절반이 안 됐다(19.2% vs 43.2%).
+      기존처럼 블록·박스를 독립 추첨하면 목표 구간이 자연 발생률 30%라 **65ep를 얻으려고
+      200ep를 시연**해야 한다. 사람 시간이 비싸므로 조건부 추첨으로 해결한다.
+
+    왜 term 하나로 합쳤나:
+      이벤트가 base(블록) → 하위(박스) 순서라 "박스 기준으로 블록을 뽑기"가 불가능하다.
+      순서에 의존하지 않도록 **두 리셋을 한 term에서** 처리한다.
+
+    거리는 `block_dist_range`에서 **균등**하게 뽑는다(면적 균등이 아니다). 거리축을 고르게
+    덮는 것이 목적이고, 면적 균등으로 뽑으면 먼 쪽에 쏠려 정작 취약한 근거리가 적어진다.
+
+    도달 범위(block_min/max_dist, block_angle_range) 밖이면 재추첨한다. `neg_theta_frac`
+    만큼은 θ<0(로봇 오른쪽)을 목표로 하는데, 근접+오른쪽 조합이 SR 25%로 가장 취약했다.
+    수용률은 실측 36%(θ 부호까지 요구하면 14.5%)라 200회면 실패 확률이 사실상 0이다.
+    `max_tries`의 절반까지는 θ 부호를 요구하고, 그 뒤에는 풀어 거리 조건을 우선한다.
+    """
+    block: RigidObject = env.scene[block_name]
+    box: RigidObject = env.scene[box_name]
+    device = block.device
+    n = len(env_ids)
+
+    # ── 1) 박스 배치 (기존 reset_basket_random과 동일) ──
+    b_ang = math_utils.sample_uniform(box_angle_range[0], box_angle_range[1], (n,), device=device)
+    b_r = torch.sqrt(math_utils.sample_uniform(box_min_dist ** 2, box_max_dist ** 2, (n,), device=device))
+    box_x = base_xy[0] + b_r * torch.cos(b_ang)
+    box_y = base_xy[1] + b_r * torch.sin(b_ang)
+
+    box_default = box.data.default_root_state[env_ids].clone()
+    box_orient = box_default[:, 3:7]
+    yaw = math_utils.sample_uniform(box_yaw_range[0], box_yaw_range[1], (n,), device=device)
+    zeros = torch.zeros_like(yaw)
+    box_orient = math_utils.quat_mul(box_orient, math_utils.quat_from_euler_xyz(zeros, zeros, yaw))
+    box_pos = torch.stack([box_x, box_y, torch.full((n,), box_z, device=device)], dim=-1)
+    box.write_root_pose_to_sim(
+        torch.cat([box_pos + env.scene.env_origins[env_ids], box_orient], dim=-1), env_ids=env_ids)
+    box.write_root_velocity_to_sim(torch.zeros((n, 6), device=device), env_ids=env_ids)
+
+    # ── 2) 블록을 박스 주변 지정 거리대에 배치 (거부 샘플링) ──
+    want_neg = torch.rand((n,), device=device) < neg_theta_frac
+    bx = torch.zeros((n,), device=device)
+    by = torch.zeros((n,), device=device)
+    done = torch.zeros((n,), dtype=torch.bool, device=device)
+
+    for attempt in range(max_tries):
+        d = math_utils.sample_uniform(block_dist_range[0], block_dist_range[1], (n,), device=device)
+        phi = math_utils.sample_uniform(-3.14159265, 3.14159265, (n,), device=device)
+        cx = box_x + d * torch.cos(phi)
+        cy = box_y + d * torch.sin(phi)
+
+        rr = torch.sqrt((cx - base_xy[0]) ** 2 + (cy - base_xy[1]) ** 2)
+        th = torch.atan2(cy - base_xy[1], cx - base_xy[0])
+        ok = (rr >= block_min_dist) & (rr <= block_max_dist) \
+            & (th >= block_angle_range[0]) & (th <= block_angle_range[1])
+        # 절반 지점을 넘어가면 θ 부호 목표를 포기한다(도달 범위 충족이 우선).
+        if attempt < max_tries // 2:
+            ok = ok & (want_neg == (th < 0))
+
+        take = ok & (~done)
+        bx = torch.where(take, cx, bx)
+        by = torch.where(take, cy, by)
+        done = done | take
+        if bool(done.all()):
+            break
+
+    if not bool(done.all()):
+        # 최후 폴백: 도달 범위 안에서만 추첨(거리 조건 미충족 가능) — 씬이 멈추지 않게.
+        f_ang = math_utils.sample_uniform(block_angle_range[0], block_angle_range[1], (n,), device=device)
+        f_r = torch.sqrt(math_utils.sample_uniform(block_min_dist ** 2, block_max_dist ** 2, (n,), device=device))
+        bx = torch.where(done, bx, base_xy[0] + f_r * torch.cos(f_ang))
+        by = torch.where(done, by, base_xy[1] + f_r * torch.sin(f_ang))
+        print(f"[near] 거부 샘플링 실패 {int((~done).sum())}/{n}env — 도달범위 추첨으로 폴백")
+
+    blk_default = block.data.default_root_state[env_ids].clone()
+    blk_pos = torch.stack([bx, by, torch.full((n,), block_z, device=device)], dim=-1)
+    block.write_root_pose_to_sim(
+        torch.cat([blk_pos + env.scene.env_origins[env_ids], blk_default[:, 3:7]], dim=-1), env_ids=env_ids)
+    block.write_root_velocity_to_sim(torch.zeros((n, 6), device=device), env_ids=env_ids)
+
+
+def reset_distractors(
+        env,
+        env_ids: torch.Tensor,
+        names: list[str],
+        avoid: list[str],
+        base_xy: tuple[float, float],
+        min_dist: float,
+        max_dist: float,
+        angle_range: tuple[float, float],
+        z: float,
+        min_sep: float = 0.08,
+        max_tries: int = 200,
+):
+    """방해물을 **타깃·박스·다른 방해물과 겹치지 않게** 배치한다 (시각 grounding 평가용).
+
+    왜 별도 함수인가(2026-08-11):
+      처음엔 방해물도 `reset_prop_random_reach`로 독립 추첨했는데, 실제 캡처에서
+      **방해물끼리 붙거나 타깃을 가리는 배치**가 잦았다(3ep 중 2ep). 그러면 측정하려던
+      "타깃에 집중하는가"가 아니라 "가려진 물체를 찾는가"를 재게 되어 조건이 무의미해진다.
+
+    `avoid`에 든 에셋의 **현재 위치**를 읽어 그 반경 `min_sep` 밖에서만 뽑는다. 따라서 이 term은
+    타깃·박스 리셋보다 **뒤에** 실행돼야 한다(DR cfg의 reset_basket_random 다음에 삽입).
+
+    거부 샘플링이 `max_tries` 안에 실패하면 마지막 후보를 그대로 쓰고 경고를 남긴다 —
+    씬이 멈추는 것보다 낫고, 로그로 발생 빈도를 추적할 수 있다.
+    """
+    device = env.scene[names[0]].device
+    n = len(env_ids)
+    org = env.scene.env_origins[env_ids]
+
+    # 피해야 할 좌표(월드 → env 로컬)
+    occupied = []
+    for a in avoid:
+        occupied.append(env.scene[a].data.root_pos_w[env_ids, :2] - org[:, :2])
+
+    for name in names:
+        asset: RigidObject = env.scene[name]
+        px = torch.zeros((n,), device=device)
+        py = torch.zeros((n,), device=device)
+        done = torch.zeros((n,), dtype=torch.bool, device=device)
+        for _ in range(max_tries):
+            ang = math_utils.sample_uniform(angle_range[0], angle_range[1], (n,), device=device)
+            r = torch.sqrt(math_utils.sample_uniform(min_dist ** 2, max_dist ** 2, (n,), device=device))
+            cx = base_xy[0] + r * torch.cos(ang)
+            cy = base_xy[1] + r * torch.sin(ang)
+            ok = torch.ones((n,), dtype=torch.bool, device=device)
+            for occ in occupied:
+                ok &= torch.sqrt((cx - occ[:, 0]) ** 2 + (cy - occ[:, 1]) ** 2) >= min_sep
+            take = ok & (~done)
+            px = torch.where(take, cx, px)
+            py = torch.where(take, cy, py)
+            done |= take
+            if bool(done.all()):
+                break
+            # 마지막 후보를 보관해 두어 전량 실패 시에도 좌표가 비지 않게 한다
+            px = torch.where(done, px, cx)
+            py = torch.where(done, py, cy)
+        if not bool(done.all()):
+            print(f"[distractor] {name}: 거부 샘플링 실패 {int((~done).sum())}/{n}env "
+                  f"— 겹칠 수 있으니 해당 ep는 확인할 것")
+        default = asset.data.default_root_state[env_ids].clone()
+        pos = torch.stack([px, py, torch.full((n,), z, device=device)], dim=-1)
+        asset.write_root_pose_to_sim(torch.cat([pos + org, default[:, 3:7]], dim=-1), env_ids=env_ids)
+        asset.write_root_velocity_to_sim(torch.zeros((n, 6), device=device), env_ids=env_ids)
+        # 다음 방해물은 이번에 놓은 것도 피한다
+        occupied.append(torch.stack([px, py], dim=-1))
+
+
+def reset_box_and_block_clear(
+        env,
+        env_ids: torch.Tensor,
+        block_name: str,
+        box_name: str,
+        base_xy: tuple[float, float],
+        box_min_dist: float,
+        box_max_dist: float,
+        box_angle_range: tuple[float, float],
+        box_yaw_range: tuple[float, float],
+        box_z: float,
+        block_min_dist: float,
+        block_max_dist: float,
+        block_angle_range: tuple[float, float],
+        block_z: float,
+        box_half_extent: tuple[float, float] = (0.040, 0.082),
+        clearance: float = 0.03,
+        max_tries: int = 200,
+):
+    """박스를 놓고, **그 박스와 겹치지 않는** 자리에 블록을 놓는다 (평가 전용, 2026-08-12).
+
+    왜 term 하나로 합쳤나:
+      이벤트 실행 순서가 base(블록) → 하위(박스)라, 블록 리셋 시점에는 박스가 아직 이번
+      에피소드 자리로 옮겨지지 않았다. 그래서 '박스를 읽고 피해서 뽑기'가 성립하지 않는다.
+      실측(seed 31, 10ep): 분리된 term으로는 3/10이 겹침권에 남았다.
+      reset_block_near_box(v4 수집용)가 같은 이유로 이미 합쳐져 있다 — 같은 처방을 쓴다.
+
+    왜 중심거리가 아니라 사각형 간격인가:
+      박스는 (4.0, 8.2)cm 직사각형이고 yaw가 ±180° 무작위다. 중심거리 하나로 자르면 긴 변
+      쪽은 여전히 겹치고 짧은 변 쪽은 **유효한 근접 배치까지 걸린다** — v3 병목이 그 과잉
+      필터였다(학습 근접 19.2% vs 자연 43.2%). 박스 로컬로 변환해 재면 근접을 살린 채
+      겹침만 막는다.
+
+    ※ 블록 표집은 기존과 같은 **환형 균일**이다. 거리대를 직접 뽑는 near 방식과 달리
+       공간 분포를 바꾸지 않는다 — 평가 분포를 건드리지 않기 위해서다.
+    """
+    block: RigidObject = env.scene[block_name]
+    box: RigidObject = env.scene[box_name]
+    n = len(env_ids)
+    dev = block.device
+
+    # ── 1) 박스: 기존 reset_basket_random과 동일 사양 ──
+    b_ang = math_utils.sample_uniform(box_angle_range[0], box_angle_range[1], (n,), device=dev)
+    b_r = torch.sqrt(math_utils.sample_uniform(box_min_dist ** 2, box_max_dist ** 2, (n,), device=dev))
+    bx = base_xy[0] + b_r * torch.cos(b_ang)
+    by = base_xy[1] + b_r * torch.sin(b_ang)
+    b_yaw = math_utils.sample_uniform(box_yaw_range[0], box_yaw_range[1], (n,), device=dev)
+
+    box_state = box.data.default_root_state[env_ids].clone()
+    zeros = torch.zeros_like(b_yaw)
+    dq = math_utils.quat_from_euler_xyz(zeros, zeros, b_yaw)
+    box_quat = math_utils.quat_mul(box_state[:, 3:7], dq)
+    box_pos = torch.stack([bx, by, torch.full((n,), box_z, device=dev)], dim=-1)
+    box.write_root_pose_to_sim(
+        torch.cat([box_pos + env.scene.env_origins[env_ids], box_quat], dim=-1), env_ids=env_ids)
+    box.write_root_velocity_to_sim(torch.zeros((n, 6), device=dev), env_ids=env_ids)
+
+    # ── 2) 블록: 환형 균일 + 박스 사각형 기각 (방금 뽑은 값을 그대로 쓴다 = 버퍼 갱신 무관) ──
+    hx = box_half_extent[0] + clearance
+    hy = box_half_extent[1] + clearance
+    c, s_ = torch.cos(-b_yaw), torch.sin(-b_yaw)
+    x = torch.zeros((n,), device=dev)
+    y = torch.zeros((n,), device=dev)
+    pending = torch.ones((n,), dtype=torch.bool, device=dev)
+    cx = cy = None
+    for _ in range(max_tries):
+        if not pending.any():
+            break
+        ang = math_utils.sample_uniform(block_angle_range[0], block_angle_range[1], (n,), device=dev)
+        r = torch.sqrt(math_utils.sample_uniform(block_min_dist ** 2, block_max_dist ** 2, (n,), device=dev))
+        cx = base_xy[0] + r * torch.cos(ang)
+        cy = base_xy[1] + r * torch.sin(ang)
+        dx, dy = cx - bx, cy - by
+        lx = (dx * c - dy * s_).abs()
+        ly = (dx * s_ + dy * c).abs()
+        ok = (lx > hx) | (ly > hy)
+        take = pending & ok
+        x = torch.where(take, cx, x)
+        y = torch.where(take, cy, y)
+        pending = pending & ~ok
+    if pending.any():
+        # 도달 영역이 박스로 거의 덮인 극단 배치에서만 발생. 멈추는 것보다 낫고,
+        # scenes.csv에 거리가 남으므로 사후 제외가 가능하다.
+        x = torch.where(pending, cx, x)
+        y = torch.where(pending, cy, y)
+
+    blk_pos = torch.stack([x, y, torch.full((n,), block_z, device=dev)], dim=-1)
+    blk_quat = block.data.default_root_state[env_ids].clone()[:, 3:7]
+    block.write_root_pose_to_sim(
+        torch.cat([blk_pos + env.scene.env_origins[env_ids], blk_quat], dim=-1), env_ids=env_ids)
+    block.write_root_velocity_to_sim(torch.zeros((n, 6), device=dev), env_ids=env_ids)
+
+
+def reset_prop_clear_of_box(
+        env,
+        env_ids: torch.Tensor,
+        asset_name: str,
+        box_name: str,
+        base_xy: tuple[float, float],
+        min_dist: float,
+        max_dist: float,
+        angle_range: tuple[float, float],
+        z: float,
+        box_half_extent: tuple[float, float] = (0.040, 0.082),
+        clearance: float = 0.03,
+        max_tries: int = 200,
+):
+    """reset_prop_random_reach와 같되, **박스와 겹치는 표본을 기각**한다.
+
+    왜 필요한가(2026-08-12):
+      평가 씬에서 박스와 블록을 독립 추첨하다 보니 블록이 박스 안이나 벽에 붙어 스폰되는
+      에피소드가 나온다. 실측(seed 999): 블록-박스 중심거리 4.7cm — 박스 반경이 (4.0, 8.2)cm이므로
+      **블록이 박스 안에 들어가 있다**. 이런 ep는 시행 자체가 성립하지 않는데도 분모에 들어가
+      성공률을 끌어내린다. 지금까지는 scenes.csv의 block_box_dist로 사후 제외해 왔지만,
+      45ep 중 몇 개가 버려질지 미리 알 수 없어 유효 표본이 들쭉날쭉했다. 표집에서 막는다.
+
+    왜 중심거리 임계값이 아니라 사각형 간격인가:
+      박스는 (4.0, 8.2)cm의 **직사각형**이고 yaw가 ±180° 무작위다. 중심거리 하나로 자르면
+      긴 변 쪽(8.2cm)에서는 여전히 겹치고, 짧은 변 쪽(4.0cm)에서는 **유효한 근접 배치까지
+      함께 걸러진다** — v3의 병목이 정확히 그 과잉 필터였다(학습 근접 비율 19.2% vs 자연 43.2%).
+      박스 로컬 좌표로 변환해 사각형 표면까지의 거리를 재면 근접 구간을 살린 채 겹침만 막는다.
+
+    clearance=0.03: 블록 반크기 1cm를 빼면 벽면과 약 2cm — 그리퍼가 들어갈 최소 폭.
+    """
+    asset: RigidObject = env.scene[asset_name]
+    box: RigidObject = env.scene[box_name]
+    n = len(env_ids)
+    dev = asset.device
+
+    # 박스는 이 시점에 이미 배치돼 있다(reset_basket_random이 먼저 선언돼 있어야 한다).
+    box_pos = box.data.root_pos_w[env_ids] - env.scene.env_origins[env_ids]
+    box_quat = box.data.root_quat_w[env_ids]
+    _, _, box_yaw = math_utils.euler_xyz_from_quat(box_quat)
+
+    hx = box_half_extent[0] + clearance
+    hy = box_half_extent[1] + clearance
+
+    x = torch.zeros((n,), device=dev)
+    y = torch.zeros((n,), device=dev)
+    pending = torch.ones((n,), dtype=torch.bool, device=dev)
+    for _ in range(max_tries):
+        if not pending.any():
+            break
+        angle = math_utils.sample_uniform(angle_range[0], angle_range[1], (n,), device=dev)
+        r = torch.sqrt(math_utils.sample_uniform(min_dist ** 2, max_dist ** 2, (n,), device=dev))
+        cx = base_xy[0] + r * torch.cos(angle)
+        cy = base_xy[1] + r * torch.sin(angle)
+        # 박스 로컬 좌표로 회전 변환 → 축정렬 사각형과의 관계로 단순화
+        dx = cx - box_pos[:, 0]
+        dy = cy - box_pos[:, 1]
+        c, s = torch.cos(-box_yaw), torch.sin(-box_yaw)
+        lx = (dx * c - dy * s).abs()
+        ly = (dx * s + dy * c).abs()
+        ok = (lx > hx) | (ly > hy)          # 확장 사각형 밖이면 채택
+        take = pending & ok
+        x = torch.where(take, cx, x)
+        y = torch.where(take, cy, y)
+        pending = pending & ~ok
+    if pending.any():
+        # 전부 실패하면 마지막 표본을 그대로 쓴다 — 멈추는 것보다 낫고, scenes.csv에 거리가 남아
+        # 사후 제외가 가능하다. 도달 영역이 박스로 거의 덮인 극단 배치에서만 발생한다.
+        x = torch.where(pending, cx, x)
+        y = torch.where(pending, cy, y)
+
+    z_t = torch.full((n,), z, device=dev)
+    world_pos = torch.stack([x, y, z_t], dim=-1) + env.scene.env_origins[env_ids]
+    orientation = asset.data.default_root_state[env_ids].clone()[:, 3:7]
+    asset.write_root_pose_to_sim(torch.cat([world_pos, orientation], dim=-1), env_ids=env_ids)
+    asset.write_root_velocity_to_sim(torch.zeros((n, 6), device=dev), env_ids=env_ids)
+
+
+def reset_fixed_panel(
+        env,
+        env_ids: torch.Tensor,
+        block_name: str,
+        box_name: str,
+        base_xy: tuple[float, float],
+        panel: list,
+        block_z: float,
+        box_z: float,
+):
+    """미리 정한 배치 목록을 **에피소드 순서대로 재생**한다 (평가 전용, 2026-08-12).
+
+    왜 필요한가:
+      평가 B가 묻는 것은 '색·형상·문장이 바뀌어도 되는가'인데, 매 에피소드 위치가 새로
+      뽑히면 조건 간 차이에 **위치 난이도가 섞인다**. 실측으로 그 크기가 컸다 —
+      같은 모델·같은 조건인데 시드만 바꾸니 70%(seed 31 구패널)와 30%(신패널)로 갈렸다.
+      배치를 고정하면 조건 간 차이가 오직 바뀐 축에서만 온다.
+
+    panel: [[block_r, block_theta, box_r, box_theta, box_yaw], ...] (로봇 base 기준 극좌표)
+      성공∧비겹침 에피소드에서 근접/원거리 × 좌/중/우 균등하게 뽑은 10개.
+      ※ 성공 씬만 골랐으므로 **기준선(L0)은 정의상 천장**이다. 절대 성공률의 추정치가
+        아니라 '조건을 바꾸면 몇 개가 무너지는가'를 보는 척도다.
+
+    에피소드 인덱스는 env에 카운터를 달아 센다. len(panel)을 넘으면 순환한다.
+    """
+    block: RigidObject = env.scene[block_name]
+    box: RigidObject = env.scene[box_name]
+    dev = block.device
+    n = len(env_ids)
+
+    # 리셋 이벤트는 **에피소드당 두 번** 불린다(실측 2026-08-12: 사용된 인덱스가
+    # 0,2,4,6,8,0,2,… 로 5개만 두 번씩 재생됐다). 단순 증가 카운터를 쓰면 절반이 건너뛰어진다.
+    # 같은 스텝에서 다시 불리면 직전 인덱스를 그대로 재사용해 중복 호출을 흡수한다.
+    if not hasattr(env, "_panel_idx"):
+        env._panel_idx = torch.zeros(env.num_envs, dtype=torch.long, device=dev)
+        env._panel_last = torch.full((env.num_envs,), -1, dtype=torch.long, device=dev)
+    step = int(getattr(env, "common_step_counter", 0))
+    same = env._panel_last[env_ids] == step
+    cur = env._panel_idx[env_ids]
+    idx = torch.where(same, cur - 1, cur) % len(panel)
+    env._panel_idx[env_ids] = torch.where(same, cur, cur + 1)
+    env._panel_last[env_ids] = step
+
+    tbl = torch.tensor(panel, dtype=torch.float32, device=dev)   # (P, 5)
+    row = tbl[idx]                                               # (n, 5)
+    br, bt, xr, xt, xyaw = row[:, 0], row[:, 1], row[:, 2], row[:, 3], row[:, 4]
+
+    bx = base_xy[0] + xr * torch.cos(xt)
+    by = base_xy[1] + xr * torch.sin(xt)
+    box_state = box.data.default_root_state[env_ids].clone()
+    zeros = torch.zeros_like(xyaw)
+    dq = math_utils.quat_from_euler_xyz(zeros, zeros, xyaw)
+    box_quat = math_utils.quat_mul(box_state[:, 3:7], dq)
+    box_pos = torch.stack([bx, by, torch.full((n,), box_z, device=dev)], dim=-1)
+    box.write_root_pose_to_sim(
+        torch.cat([box_pos + env.scene.env_origins[env_ids], box_quat], dim=-1), env_ids=env_ids)
+    box.write_root_velocity_to_sim(torch.zeros((n, 6), device=dev), env_ids=env_ids)
+
+    kx = base_xy[0] + br * torch.cos(bt)
+    ky = base_xy[1] + br * torch.sin(bt)
+    blk_pos = torch.stack([kx, ky, torch.full((n,), block_z, device=dev)], dim=-1)
+    blk_quat = block.data.default_root_state[env_ids].clone()[:, 3:7]
+    block.write_root_pose_to_sim(
+        torch.cat([blk_pos + env.scene.env_origins[env_ids], blk_quat], dim=-1), env_ids=env_ids)
+    block.write_root_velocity_to_sim(torch.zeros((n, 6), device=dev), env_ids=env_ids)
+
+
+# ── 배경·작업면 교체 (평가 B, 2026-08-12) ─────────────────────────────
+SURFACE_PRIMS = (
+    "/World/envs/env_0/LightStudio/LightBox/Base",   # 라이트박스 바닥
+    "/World/envs/env_0/Mat",                         # 그 위 매트 = 실제 작업면
+)
