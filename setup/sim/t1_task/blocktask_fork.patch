+def apply_scene_dressing(env, env_ids, bg="", hide="", surface_tex="",
+                         surface_uv=4.0, bg_pos=(0.0, 0.0, 0.0), bg_scale=1.0):
+    """배경 USD를 얹고 라이트박스 벽을 숨기고 작업면 재질을 바꾼다. **mode="startup"** 전용.
+
+    ⚠ env_ids에 기본값을 주면 안 된다. IsaacLab EventManager가 그것을 '호출자가 넘겨야 할
+      선택 파라미터'로 분류해, params에 없다고 ValueError를 낸다(실측 2026-08-12).
+      startup 모드에서는 매니저가 env_ids=None을 위치 인자로 넘긴다.
+
+    왜 startup인가:
+      재질 바인딩·prim 삽입은 stage가 만들어진 뒤에만 가능하다. cfg의 __post_init__
+      단계에서는 stage가 없다. reset마다 하면 매번 셰이더를 다시 만들어 낭비다.
+
+    왜 라이트박스를 지우지 않고 숨기는가:
+      top 카메라와 RectLight가 `LightStudio/LightBox` 하위에 매달려 있다. 지우면 시점과
+      조명이 함께 바뀌어, '배경 픽셀의 영향'과 '시점·조명 변화'가 뒤섞인다.
+
+    ⚠ 이름은 **전체 일치**로 맞춘다. 부분 문자열이면 "Back"이 카메라 케이스 "Case_back"까지
+      걸어 D455 모델 일부가 사라진다(실측 2026-08-12).
+    """
+    import omni.usd
+    from pxr import Gf, Sdf, UsdGeom, UsdShade
+
+    stage = omni.usd.get_context().get_stage()
+
+    if hide:
+        needles = [h.strip().lower() for h in hide.split(",") if h.strip()]
+        root = "/World/envs/env_0/LightStudio/LightBox"
+        n = 0
+        for pr in stage.Traverse():
+            path = str(pr.GetPath())
+            if not path.startswith(root):
+                continue
+            name = pr.GetName()
+            if name.lower() in needles:
+                if pr.GetTypeName() in ("Camera", "RectLight") or "camera" in name.lower():
+                    continue
+                im = UsdGeom.Imageable(pr)
+                if im:
+                    im.MakeInvisible()
+                    n += 1
+        print(f"[dress] 벽 숨김 {n}개", flush=True)
+
+    if surface_tex:
+        mat = UsdShade.Material.Define(stage, "/World/Looks/SurfaceMat")
+        sh = UsdShade.Shader.Define(stage, "/World/Looks/SurfaceMat/PBR")
+        sh.CreateIdAttr("UsdPreviewSurface")
+        sh.CreateInput("roughness", Sdf.ValueTypeNames.Float).Set(0.7)
+        sh.CreateInput("metallic", Sdf.ValueTypeNames.Float).Set(0.0)
+        rd = UsdShade.Shader.Define(stage, "/World/Looks/SurfaceMat/stReader")
+        rd.CreateIdAttr("UsdPrimvarReader_float2")
+        rd.CreateInput("varname", Sdf.ValueTypeNames.Token).Set("st")
+        rd.CreateOutput("result", Sdf.ValueTypeNames.Float2)
+        if surface_uv != 1.0:
+            rd.CreateInput("scale", Sdf.ValueTypeNames.Float2).Set(Gf.Vec2f(surface_uv, surface_uv))
+        tx = UsdShade.Shader.Define(stage, "/World/Looks/SurfaceMat/Tex")
+        tx.CreateIdAttr("UsdUVTexture")
+        tx.CreateInput("file", Sdf.ValueTypeNames.Asset).Set(surface_tex)
+        tx.CreateInput("wrapS", Sdf.ValueTypeNames.Token).Set("repeat")
+        tx.CreateInput("wrapT", Sdf.ValueTypeNames.Token).Set("repeat")
+        tx.CreateInput("st", Sdf.ValueTypeNames.Float2).ConnectToSource(rd.ConnectableAPI(), "result")
+        tx.CreateOutput("rgb", Sdf.ValueTypeNames.Float3)
+        sh.CreateInput("diffuseColor", Sdf.ValueTypeNames.Color3f).ConnectToSource(
+            tx.ConnectableAPI(), "rgb")
+        sh.CreateOutput("surface", Sdf.ValueTypeNames.Token)
+        mat.CreateSurfaceOutput().ConnectToSource(sh.ConnectableAPI(), "surface")
+        for t in SURFACE_PRIMS:
+            pr = stage.GetPrimAtPath(t)
+            if pr and pr.IsValid():
+                UsdShade.MaterialBindingAPI.Apply(pr)
+                UsdShade.MaterialBindingAPI(pr).Bind(mat)
+                print(f"[dress] 작업면 바인딩 {t}", flush=True)
+
+    if bg:
+        prim = stage.DefinePrim("/World/Background", "Xform")
+        prim.GetReferences().AddReference(bg)
+        x = UsdGeom.Xformable(prim)
+        x.ClearXformOpOrder()
+        # ClearXformOpOrder는 순서만 지운다 — 기존 속성이 double3라 float으로 만들면 예외
+        x.AddTranslateOp(UsdGeom.XformOp.PrecisionDouble).Set(Gf.Vec3d(*bg_pos))
+        x.AddScaleOp(UsdGeom.XformOp.PrecisionDouble).Set(Gf.Vec3d(bg_scale, bg_scale, bg_scale))
+        print(f"[dress] 배경 {bg}", flush=True)
+
+
+# ── 언어 조건화 씬 리셋 (2026-09-14, language_conditioning_sim_plan.md §3-2) ──────────
+_LANG_PLAN_CACHE = {}
