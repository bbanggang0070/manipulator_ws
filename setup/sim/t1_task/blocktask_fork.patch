+def _write_mp4(path, frames, fps=30):
+    """headless 평가에서 롤아웃 프레임을 mp4로 저장(PyAV, libx264). 실패해도 평가는 계속."""
+    try:
+        import av
+        container = av.open(path, mode="w")
+        stream = container.add_stream("libx264", rate=fps)
+        stream.height, stream.width = frames[0].shape[:2]
+        stream.pix_fmt = "yuv420p"
+        for f in frames:
+            vf = av.VideoFrame.from_ndarray(np.ascontiguousarray(f), format="rgb24")
+            for pkt in stream.encode(vf):
+                container.mux(pkt)
+        for pkt in stream.encode():
+            container.mux(pkt)
+        container.close()
+        print(f"[VIDEO] saved {path} ({len(frames)} frames)")
+    except Exception as e:
+        print(f"[VIDEO] failed to save {path}: {e}")
+
